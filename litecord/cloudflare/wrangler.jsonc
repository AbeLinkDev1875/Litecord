{
  // Cloudflare settings for LiteCord. Deploy with: npx wrangler deploy
  "name": "litecord",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "INBOX", "class_name": "Inbox" }]
  },
  // SQLite-backed Durable Objects work on Cloudflare's free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Inbox"] }]
}
